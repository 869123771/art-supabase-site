{
  "name": "art-supabase-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "亿企工场官方网站",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/wangyanghub/art-supabase-site.git"
  },
  "license": "MulanPSL-2.0",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.28.2"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3022",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3022",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,vue}\" vite.config.ts eslint.config.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.12"
  }
}
